# env.example — نموذج متغيرات البيئة (قيم وهمية فقط)
# انسخ إلى .env (متجاهَل في git) واملأ قيماً حقيقية. لا تُلتزم أسرار أبداً.

# GitHub — للدفع عبر GIT_ASKPASS فقط؛ لا يُطبع ولا يُكتب في URLs
GH_TOKEN=

# الذاكرة طويلة المدى (Mem0) — من https://app.mem0.ai
MEM0_API_KEY=
MEM0_USER_ID=
MEM0_AGENT_ID=

# تيليجرام (إن كان المشروع يرفع للمحتوى)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=state/tg.session

# الماراثون
FWD_BUDGET=
