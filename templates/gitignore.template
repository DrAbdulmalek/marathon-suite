# gitignore.template — قواعد موحّدة (تُدمج مع .gitignore الموجود، لا تُستبدل به)

# أسرار — ممنوعة من التتبع نهائياً
.secrets/
.env
.env.*
*.session
*.session-journal

# بايثون
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
.eslintcache

# قواعد بيانات محلية
*.db
*.sqlite
*.sqlite3
dev.db*

# حالة تشغيلية محلية (لا تُنشر)
state/
!state/.gitkeep

# أنظمة
.DS_Store
Thumbs.db
